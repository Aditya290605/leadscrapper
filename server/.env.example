# Google Places API (New) — https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=your_places_api_key_here

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP — enable 2FA, then create app password at https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Sender info (used in email template)
SENDER_NAME=Your Name
SENDER_STUDIO=Your Studio Name
SENDER_PHONE=+91 98765 43210
CTA_URL=https://your-portfolio-or-calendly-link.com

# Limits
DAILY_EMAIL_CAP=50
EMAIL_DELAY_MS=3000

PORT=3001
